# Environment Variables

# API Base URL (Required for production)
# For local development, use: http://localhost:3000/api
# For production, replace with your backend URL
VITE_API_URL=http://localhost:3001/api

# Optional: Enable debug mode
# VITE_DEBUG=true

# Optional: API timeout in milliseconds
# VITE_API_TIMEOUT=30000

# LiveKit Server URL (for live broadcasting)
# For local development: ws://localhost:7880
# For production: wss://your-domain.com:7880 or ws://SERVER_IP:7880
VITE_LIVEKIT_URL=ws://localhost:7880
