{
  "name": "darin-institute-management",
  "version": "2.0.0",
  "description": "نظام إدارة شامل لدارين لتعليم و التدريب",
  "author": "Darin Institute",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.js",
    "postinstall": "cd server && npm install && cd .. && npm run build",
    "start": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "deploy:frontend": "npm run build && vercel --prod",
    "deploy:backend": "railway up"
  },
  "dependencies": {
