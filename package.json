{
  "name": "darin-institute-management",
  "version": "2.0.0",
  "description": "نظام إدارة شامل لدارين السابعة للتعليم والتدريب",
  "author": "Darin Institute",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/convert-webp.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.js",
    "postinstall": "cd server && npm install",
    "start": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "deploy:frontend": "npm run build && vercel --prod",
    "deploy:backend": "railway up",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-persist-client": "^5.100.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "dompurify": "^3.4.5",
    "framer-motion": "^12.38.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.3",
    "react-virtuoso": "^4.18.7",
    "recharts": "^2.12.2",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.0.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.14.6",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "svgo": "^4.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.22.0",
    "vite": "^5.2.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "education",
    "institute",
    "management",
    "react",
    "typescript",
    "vite",
    "معهد",
    "إدارة",
    "تعليم"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/darin-institute"
  }
}
