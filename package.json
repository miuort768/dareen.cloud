    "@types/peerjs": "^0.0.30",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "date-fns": "^3.3.1",
    "emoji-picker-react": "^4.17.3",
    "json-server": "^0.17.4",
    "lucide-react": "^0.344.0",
    "peerjs": "^1.5.5",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite": "^5.1.1",
