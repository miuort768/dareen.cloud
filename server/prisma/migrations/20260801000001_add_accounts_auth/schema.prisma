generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========== Phase 1: Core Domain ==========

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  password     String
  role         String   @default("admin")
  permissions  String?
  tokenVersion Int      @default(1) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Teacher {
  id          String       @id @default(cuid())
  name        String
  phone1      String?
  phone2      String?
  subject     String?
  price       Int          @default(0)
  email       String?
  username    String?      @unique
  password    String?
  points      Int          @default(0)
  currency    String       @default("EGP")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  enrollments    Enrollment[]
  sessions       Session[]
  invoices       TeacherInvoice[]
  evaluations    Evaluation[]
  trialSessions  TrialSession[]
  availability   TeacherAvailability[]
  activeSessions ActiveSession[]
  liveSessions   LiveSession[]

  @@index([email])
  @@index([phone1])
  @@map("teachers")
}

model Student {
  id           String       @id @default(cuid())
  name         String
  grade        String?
  parentPhone  String?      @map("parent_phone")
  studentPhone  String?     @map("student_phone")
  curriculum   String?
  notes        String?
  sessionPrice Int          @default(0) @map("session_price")
  currency     String       @default("KWD")
  parentId     String?
  parent       Parent?      @relation(fields: [parentId], references: [id], onDelete: SetNull)
  totalPoints  Int          @default(0) @map("total_points")
  badges       String?
  username     String?      @unique
  password     String?
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  enrollments   Enrollment[]
  pointsLogs    PointsLog[]
  sessions      Session[]
  invoices      StudentInvoice[]
  evaluations   Evaluation[]
  activeSessions ActiveSession[]

  @@index([parentId])
  @@index([studentPhone])
  @@map("students")
}

model Parent {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  username  String?   @unique
  password  String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  students Student[]

  @@index([phone])
  @@map("parents")
}

model Enrollment {
  id               Int      @id @default(autoincrement())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId        String?
  teacher          Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherFallback  String?  @map("teacher")
  subject          String?
  curr             String?
  sessionsTotal    Int      @default(0) @map("sessions_total")
  sessionsUsed     Int      @default(0) @map("sessions_used")
  teacherPrice     Int?     @map("teacher_price")
  schedule         String?
  nextSessionNotes String?  @map("next_session_notes")
  isFrozen         Int?     @default(0) @map("isFrozen")
  frozenReason     String?  @map("frozenReason")
  deletedAt       DateTime? @map("deleted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([teacherId])
  @@map("enrollments")
}

model PointsLog {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Int
  action    String
  timestamp DateTime @default(now())

  @@index([studentId])
  @@map("points_log")
}

// ========== Phase 2: Education Domain ==========

model Session {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId        String?
  teacher          Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  studentName      String?
  teacherName      String?
  subject          String?
  date             String   @map("date")
  day              String?
  time             String?
  price            Int      @default(0)
  teacherPrice     Int?     @default(0) @map("teacherPrice")
  studentCurrency  String?
  teacherCurrency  String?
  exchangeRateFrom String?
  exchangeRateTo   String?
  exchangeRateValue Decimal? @db.Decimal(18, 8)
  status           String   @default("scheduled")
  topics           String?
  homework         String?
  needsCompensation Int?    @default(0) @map("needsCompensation")
  isArchived       Int?     @default(0) @map("is_archived")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@index([teacherId])
  @@index([date])
  @@map("sessions")
}

model LiveSession {
  id                String    @id @default(cuid())
  teacherId         String
  teacher           Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherName       String
  title             String?
  subject           String?
  meetingProvider   String    @default("google_meet")
  meetingUrl        String?
  meetingCode       String?
  isExternalMeeting Boolean   @default(true)
  status            String    @default("active")
  targetStudentId   String?
  startedAt         DateTime  @default(now()) @map("started_at")
  endedAt           DateTime? @map("ended_at")
  endedBy           String?

  @@index([teacherId, status])
  @@map("live_sessions")
}

model ActiveSession {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherName  String
  subject      String
  timerSeconds Int?     @default(0) @map("timerSeconds")
  startedAt    DateTime @default(now()) @map("startedAt")

  @@index([teacherId])
  @@index([studentId])
  @@map("active_sessions")
}

model Evaluation {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherName String?
  sessionId  String?  @map("sessionId")
  date       String
  rating     String
  notes      String?
  points     Int?     @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@index([teacherId])
  @@map("evaluations")
}

model TrialSession {
  id           String   @id @default(cuid())
  studentName  String
  parentPhone  String
  subject      String?
  teacherId    String?
  teacher      Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherName  String?
  date         String
  time         String?
  status       String   @default("pending")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([teacherId])
  @@index([status])
  @@index([date])
  @@map("trial_sessions")
}

model TeacherAvailability {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherName String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Int?     @default(1) @map("isAvailable")

  @@index([teacherId])
  @@map("teacher_availability")
}

// ========== Phase 3: Finance Domain ==========

model Currency {
  code      String @id
  name      String
  symbol    String
  isActive  Int    @default(1)
  sortOrder Int    @default(0)

  @@map("currencies")
}

model ExchangeRate {
  id            Int      @id @default(autoincrement())
  fromCurrency  String
  toCurrency    String
  buyRate       Decimal @db.Decimal(18, 8)
  sellRate      Decimal @db.Decimal(18, 8)
  effectiveDate DateTime
  notes         String?
  createdAt     DateTime @default(now())
  createdBy     String?

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@map("exchange_rates")
}

model FinancialSetting {
  key   String  @id
  value String?

  @@map("financial_settings")
}

model StudentInvoice {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName   String?
  amount        Int
  currency      String?
  description   String?
  date          String
  dueDate       String?
  status        String   @default("unpaid")
  paymentMethod String?
  notes         String?
  items         String?
  isArchived    Int?      @default(0) @map("is_archived")
  paidAt        String?
  deletedAt     DateTime?

  @@index([studentId])
  @@index([status])
  @@index([date])
  @@map("student_invoices")
}

model TeacherInvoice {
  id               String   @id @default(cuid())
  teacherId        String?
  teacher          Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherName      String?  @map("teacher")
  specialization   String?
  amount           Int
  currency         String?
  paymentMethod    String?
  status           String   @default("unpaid")
  personalExpenses Int?     @default(0) @map("personalExpenses")
  date             String
  isArchived       Int?      @default(0) @map("is_archived")
  paidAt           String?
  deletedAt        DateTime?

  @@index([teacherId])
  @@index([status])
  @@index([date])
  @@map("teacher_invoices")
}

model ManualTransaction {
  id          String   @id @default(cuid())
  type        String
  category    String?
  amount      Float?
  currency    String?
  date        String
  description String?
  status      String   @default("completed")
  isArchived  Int?     @default(0) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type, status, date])
  @@map("manual_transactions")
}

model FixedExpense {
  id       Int     @id @default(autoincrement())
  name     String
  amount   Float?  @default(0)
  currency String?
  isActive Int?    @default(1) @map("is_active")

  @@index([isActive])
  @@map("fixed_expenses")
}

// ========== Phase 4: Content & Communication ==========

model BlogPost {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  excerpt            String?
  content            String?
  coverImage         String?
  category           String?
  keywords           String?
  author             String?
  date               String?
  contentType        String?
  curriculum         String?
  level              String?
  grade              String?
  term               String?
  subject            String?
  downloadLink       String?
  watchLink          String?
  views              Int?     @default(0)
  showButtons        Int?     @default(1) @map("show_buttons")
  downloadButtonText String?  @map("download_button_text")
  watchButtonText    String?  @map("watch_button_text")
  source             String?
  fileSize           String?  @map("file_size")
  seoTitle           String?  @map("seo_title")
  seoDescription     String?  @map("seo_description")
  ogImage            String?  @map("og_image")
  focusKeyword       String?  @map("focus_keyword")
  readingTime        Int?     @default(0) @map("reading_time")
  canonicalUrl       String?  @map("canonical_url")
  robotsIndex        Int?     @default(1) @map("robots_index")
  isFeatured         Int?     @default(0) @map("is_featured")
  tags               String?
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([date])
  @@index([category])
  @@index([contentType])
  @@index([curriculum])
  @@index([subject])
  @@index([isFeatured])
  @@map("blog_posts")
}

model BlogCustomer {
  id        String   @id @default(cuid())
  country   String
  phone     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([country])
  @@index([createdAt])
  @@map("blog_customers")
}

model Lead {
  id          String   @id @default(cuid())
  studentName String
  phone       String
  subject     String?
  curriculum  String?
  status      String   @default("new")
  priority    String   @default("medium")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

model JobApplication {
  id              String   @id @default(cuid())
  name            String
  phone           String
  whatsapp        String?
  position        String
  qualification   String
  grade           String?
  subject         String?
  graduationYear  String?
  onlineYears     String?
  curriculums     String?
  contacted       Int?     @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([position])
  @@index([phone])
  @@map("job_applications")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name       String?
  phone      String
  subject    String?
  curriculum String?
  message    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("contact_messages")
}

model Conversation {
  id        String   @id @default(cuid())
  name      String?
  isGroup   Int?     @default(0) @map("isGroup")
  createdBy String?
  isLive    Int?     @default(0) @map("isLive")
  meetingUrl String?  @map("meetingUrl")
  createdAt DateTime @default(now()) @map("createdAt")

  members ConversationMember[]
  messages Message[]

  @@index([createdBy])
  @@map("conversations")
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String
  content        String
  timestamp      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, timestamp])
  @@map("messages")
}

model ChatProfile {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  avatar    String?
  status    String?  @default("offline")
  lastSeen  DateTime?
  createdAt DateTime @default(now()) @map("createdAt")

  @@map("chat_profiles")
}

model ForumPost {
  id         String   @id @default(cuid())
  authorId   String
  authorName String
  authorRole String
  content    String
  status     String   @default("pending")
  upvotes    String?  @default("[]")
  downvotes  String?  @default("[]")
  createdAt  DateTime @default(now()) @map("created_at")

  comments ForumComment[]

  @@index([authorId])
  @@index([status])
  @@map("forum_posts")
}

model ForumComment {
  id         String    @id @default(cuid())
  postId     String
  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorRole String
  content    String
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([postId])
  @@map("forum_comments")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String?
  type      String?  @default("general")
  date      String
  isActive  Int?     @default(1) @map("isActive")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([date])
  @@index([isActive])
  @@map("announcements")
}

model Notification {
  id             String   @id @default(cuid())
  senderId       String?
  receiverId     String?
  senderName     String?
  title          String
  message        String?
  type           String?  @default("info")
  time           String
  read           Int?     @default(0)
  conversationId String?
  link           String?
  isDismissed    Int?     @default(0) @map("is_dismissed")

  @@index([receiverId])
  @@index([senderId])
  @@map("notifications")
}

// ========== Account Model (Unified Auth, Sprint 2.2) ==========

enum AccountType {
  ADMIN
  TEACHER
  PARENT
  STUDENT
  CHAT_USER
}

model Account {
  id                  String      @id @default(cuid())
  username            String      @unique
  normalizedLogin     String      @unique
  passwordHash        String
  accountType         AccountType
  entityId            String
  tokenVersion        Int         @default(0)
  isActive            Boolean     @default(true)
  isLocked            Boolean     @default(false)
  lastLoginAt         DateTime?
  lastPasswordChangeAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([accountType, entityId])
  @@map("accounts")
}

// ========== Phase 5: System Domain ==========

model SystemSetting {
  key   String @id
  value String?

  @@map("system_settings")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending")
  priority    String   @default("medium")
  dueDate     String?
  userId      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("tasks")
}

model CompletedSession {
  id String @id

  @@map("completed_sessions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  eventId    String   @unique @default(uuid())
  userId     String?
  username   String?
  action     String
  details    String?
  entityType String?
  entityId   String?
  timestamp  DateTime @default(now())

  // Sprint 2.1 — Enhanced Audit fields
  accountId  String?
  ipAddress  String?
  userAgent  String?
  status     String   @default("SUCCESS")
  requestId  String?
  metadata   Json?

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
  @@index([accountId])
  @@index([requestId])
  @@index([status])
  @@index([action, timestamp])
  @@index([entityType, entityId])
  @@index([eventId])
  @@map("audit_logs")
}

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String
  content   String
  isActive  Int?     @default(1) @map("isActive")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name])
  @@map("whatsapp_templates")
}

model PushSubscription {
  id           Int      @id @default(autoincrement())
  userId       String
  subscription String
  deviceType   String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model Backup {
  id        Int      @id @default(autoincrement())
  userId    String
  username  String?
  type      String   @default("manual")
  size      Int?
  status    String   @default("completed")
  filePath  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("backups")
}

// ========== Password Reset ==========

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    String
  userType  String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, userType])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ========== RBAC ==========

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  label       String
  description String?
  isSystem    Int?             @default(0)
  createdAt   DateTime         @default(now())

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  label       String
  group       String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  granted      Int        @default(1)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String
  roleId    Int
  model     String   @default("users")
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, model, roleId])
  @@index([userId])
  @@map("user_roles")
}

model PermissionAudit {
  id           Int      @id @default(autoincrement())
  userId       String
  username     String?
  action       String
  targetUserId String?
  targetRoleId Int?
  details      String?
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("permission_audit")
}
