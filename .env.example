# Environment Variables

# API Base URL (Required for production)
# For local development, use: http://localhost:3000/api
# For production, replace with your backend URL
VITE_API_URL=http://localhost:3000/api

# Optional: Enable debug mode
# VITE_DEBUG=true

# Optional: API timeout in milliseconds
# VITE_API_TIMEOUT=30000

# LiveKit Server URL (for live broadcasting)
# For local development: ws://localhost:7880
# For production: wss://your-domain.com/livekit (عبر Nginx proxy)
# VITE_LIVEKIT_URL=ws://localhost:7880

# LiveKit API credentials (مطلوبة لـ docker-compose)
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Attendance secure modal password (leave default or change)
# VITE_ATTENDANCE_SECRET=dareen@2024

# ── Docker Compose (Production) ──
# Required by docker-compose.yml
# DB_PASSWORD=change-me-strong
# REDIS_PASSWORD=change-me-strong
# JWT_SECRET=change-me-strong-secret
# FRONTEND_URL=https://dareen.cloud
